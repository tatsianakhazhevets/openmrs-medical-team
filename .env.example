OMRS_DB_HOST=db
OMRS_DB_NAME=openmrs
OMRS_DB_USER=openmrs
OMRS_DB_PASSWORD=openmrs
MYSQL_ROOT_PASSWORD=root

# Override these values for a non-default OpenMRS test account.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin123

# Container-to-container application URLs for the local stack.
API_BASE_URL=http://host.docker.internal
API_VERSION=/openmrs/ws/rest/v1
OPENMRS_URL=http://host.docker.internal/openmrs/ws/rest/v1/session
UI_BASE_URL=http://gateway/openmrs/spa
UI_REMOTE=http://host.docker.internal:4444/wd/hub
SELENOID_STATUS_URL=http://host.docker.internal:4444/status

# Set to true only when browser video is configured and needed.
UI_VIDEO=false
SELENOID_VIDEO_OUTPUT_DIR=

# The first OpenMRS startup can take several minutes.
OPENMRS_STARTUP_TIMEOUT_SECONDS=1200

# Optional local test selection, for example: -Dtest=LaboratoryApiTests
MAVEN_ARGS=
